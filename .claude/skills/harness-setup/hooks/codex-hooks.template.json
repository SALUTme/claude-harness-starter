{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" harness-status",
            "timeout": 10,
            "commandWindows": "git harness-hook harness-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" block-dangerous",
            "timeout": 10,
            "commandWindows": "git harness-hook block-dangerous"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" commit-gate",
            "timeout": 900,
            "commandWindows": "git harness-hook commit-gate"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" secret-guard",
            "timeout": 10,
            "commandWindows": "git harness-hook secret-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" after-edit-check",
            "timeout": 300,
            "commandWindows": "git harness-hook after-edit-check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-adapter.sh\" stop-gate",
            "timeout": 900,
            "commandWindows": "git harness-hook stop-gate"
          }
        ]
      }
    ]
  }
}
